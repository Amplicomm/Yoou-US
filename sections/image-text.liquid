{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .image-text-gallery {
    display: block;
  }

  .image-text-gallery__card {
    border-radius: var(--Size-size-24, 24px);
    background: radial-gradient(100.07% 100.07% at 50% -0.07%, rgba(250, 210, 186, 0.30) 0%, #BE6733 100%), var(--Color-Brand-Colour-Secondary-Colour-Cream, #F2ECD0);
    padding: 4rem 2.4rem;
    text-align: center;
    margin: 0 auto;
  }

  .image-text-gallery__heading {
    margin: 0 0 1.2rem;
    color:  #7A3717;
    text-align: center;
    font-family: "Lovan";
    font-size: 48px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-transform: capitalize;
  }

  .image-text-gallery__description {
    max-width: 100%;
    margin: 0 auto;
    color: #696061;
    text-align: center;
    font-family: "Helvetica Neue";
    font-size: 1.4rem;
    font-style: normal;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 0.64px;
  }

  .image-text-gallery__description > *:first-child {
    margin-top: 0;
  }

  .image-text-gallery__description > *:last-child {
    margin-bottom: 0;
  }

  .image-text-gallery__images {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    margin-top: 2.8rem;
  }

  .image-text-gallery__image-wrapper {
    border-radius: 1.6rem;
    overflow: hidden;
  }

  .image-text-gallery__image-wrapper img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 750px) {
    .image-text-gallery__card {
      padding: 8rem 6.4rem;
    }

    .image-text-gallery__heading {
      font-size: 3.4rem;
    }

    .image-text-gallery__images {
      grid-template-columns: 1fr 1fr;
      gap: 2.4rem;
    }
    .image-text-gallery__description {
      font-size:1.6rem;
      line-height:1.6rem;
      width:60%;
    }
  }
{%- endstyle -%}

<div class="image-text-gallery color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="image-text-gallery__card">
    {%- if section.settings.heading != blank -%}
      <h2 class="image-text-gallery__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="image-text-gallery__description rte">{{ section.settings.description }}</div>
    {%- endif -%}
    {%- if section.settings.image_1 != blank or section.settings.image_2 != blank -%}
      <div class="image-text-gallery__images">
        {%- if section.settings.image_1 != blank -%}
          <div class="image-text-gallery__image-wrapper">
            {{
              section.settings.image_1
              | image_url: width: 1000
              | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1000'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_2 != blank -%}
          <div class="image-text-gallery__image-wrapper">
            {{
              section.settings.image_2
              | image_url: width: 1000
              | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1000'
            }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Image text",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted With YOOU Intention"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every piece in the collection is designed to be a permanent companion. We work exclusively with certified 14K recycled gold and ethically sourced sterling silver, ensuring that beauty never comes at the cost of the earth.</p>"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image text"
    }
  ]
}
{% endschema %}
