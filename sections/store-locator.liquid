      display: flex;
      width: 56px;
      height: 35px;
    } {% endcomment %}

    #use-location-btn{
      display:none
    }
  }

  /* ---- Layout ---- */
  .content {
    display: flex;
    flex-direction: row;
    height: calc(100vh - 70px);
  }

  #store-details {
    width: 60%;
    overflow-y: auto;
    padding: 20px;
    background: #fff;
    border-right: 1px solid #eee;
  }

  #map {
    width: 35%;
  }

  /* ---- Store Card ---- */
  .store-card {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    border: 1px solid #ddd;
    border-radius: 12px;
    background: #fff;
    padding: 15px;
    margin-bottom: 15px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08);
