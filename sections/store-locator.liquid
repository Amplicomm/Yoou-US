<style>
  * {
    box-sizing: border-box;
  }
  :root {
    --theme-color: #E0652A; /* Litestyle color */
  }

  body {
    font-family: "Inter", Arial, sans-serif;
    margin: 0;
    padding: 0;
    background: #f8f8f8;
  }

  /* --- Header Wrapper --- */
  .store-header {
      background: #fcfaf9;
      padding: 10px 35px;
      text-align: center;
      position: sticky;
      /* Was a hardcoded 68px, hand-tuned to sit right below the site
         header + metal price bar combo — but that combo now hides itself
         on scroll down (see metal-price-bar.liquid), shrinking without
         this value following it, which left a gap here equal to however
         much shorter the header/bar got. --header-height/
         --metal-price-bar-height are the same variables that combo
         already publishes, so this always matches its current height. */
      top: calc(var(--header-height, 68px) + var(--metal-price-bar-height, 0px));
      /* Matches the site header's own hide/show transition (see
         .section-header in header.liquid) so this follows it in lockstep
         instead of snapping. */
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1;
  }

  /* Shifts up in sync with the site header when the price bar hides on
     scroll down — same trigger class, same mechanism, as header.liquid. */
  html.metal-price-bar-hidden .store-header {
    transform: translateY(calc(-1 * var(--metal-price-bar-height, 0px)));
  }
  .store-header-content ,.searchLocationWrap{
    display: flex;
    flex-direction:row;
    justify-content: space-between;
    align-items:center;
    gap:10px;
  }
  .searchLocationWrap{
    width:43%
  }

  /* --- Filter Section --- */
  .filters {
    display: flex;
    align-items: center;
    gap: 12px;
    {% comment %} overflow-x: auto;     
    overflow-y: hidden;   {% endcomment %}
    white-space: nowrap;
    scrollbar-width: thin;
    {% comment %} width:25% {% endcomment %}

  }
  .filters button {
    flex: 0 0 auto; 
  }

  /* Optional: hide scrollbar in Webkit browsers */
  .filters::-webkit-scrollbar {
    height: 6px;
  }
  .filters::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,0.2);
    border-radius: 4px;
  }

  /* --- Search Box --- */
  .search-box {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0px;
    gap: 16px;
    width: 100%;
    height: 40px;
    background: white;
    border: 2px solid #E2E2E2;
    border-radius: 14px;
    flex: none;
    order: 0;
    align-self: stretch;
    overflow:hidden
  }

  #search-btn {
    {% comment %} background: var(--theme-color);
    border-radius: 50px;
    cursor: pointer;
    margin: 5px;
    width: 30px;
    height: 30px;
    display: flex;
    justify-content: center;
    align-items: center; {% endcomment %}
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width:50px;
    height: 40px;
    border-radius: 14px;
    background: linear-gradient(180deg, var(--theme-color) 0%, #1C0E2B 142.55%);
  }

  #search-location {
    width: 90%;
    padding: 10px 14px 12px 25px;
    font-size: 14px;
    outline: none;
    border:0px
  }

  #search-location:focus {
    border-color: transparent;
  } 

  /* --- Location Button --- */
  #use-location-btn, #use-location-btn-mobile {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 12px 16px;
    gap: 10px;
    height: 40px;
    background: #FAFAFA;
    border: 1px solid var(--theme-color);
    border-radius: 14px;
    flex: none;
    width: max-content;
  }

  #topCityBtn{
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 10.8513px 14.4684px;
    gap: 9.04px;
    width: 71.94px;
    height: 40px;
    background: #FAFAFA;
    border: 0.904273px solid var(--theme-color);
    border-radius: 90.4273px;
    flex: none;
    order: 0;
    flex-grow: 0;
    color: var(--theme-color);
    cursor:pointer
  }
  .city-filter-btn.active {
    background: var(--theme-color) !important;
    color: #fff !important;
  }

  #use-location-btn-mobile{
    display:none
  }


  #use-location-btn .location-icon {
    margin-top:2px
  }

  @media (max-width: 768px) {
    .store-header {
    padding: 10px 15px;
    /* Same fix as the desktop rule above — was a hardcoded 12rem that
       didn't follow the header/price-bar combo shrinking on scroll. */
    top: calc(var(--header-height, 0px) + var(--metal-price-bar-height, 0px));
    }
    .hide-header-footer .store-header {
      top: 0;
    }

    .store-header-content ,.searchLocationWrap{
      display: flex;
      flex-direction:column !important;
      justify-content: space-between;
      align-items:center;
      gap:10px;
    }


