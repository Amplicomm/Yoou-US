    box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);
  }

  .cardImageWrap{
    width: 150px;
    height: 180px;
  }

  .store-card img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    border-radius: 10px;
  }

  .store-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .store-info h3 {
