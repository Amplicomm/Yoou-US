    text-decoration: underline;
  }

  .store-error {
    color: red;
    font-weight: bold;
  }
  .store-card.highlight {
    background-color: #e7e7e7;
    transition: all 0.3s ease;
  }
  @media (max-width: 768px) {
    .content {
      flex-direction: column;
      height:auto
    }
    #store-list,#storeSelector
    {
      width: 100% !important;
    }
    #store-details{
      width:100% !important;
