{{ 'component-hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-slider.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <hero-slider
    class="hero-slider{% unless section.settings.full_width %} page-width{% endunless %}"
    data-loop="{{ section.settings.loop }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  >
    <div class="swiper hero-slider__container">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- assign has_link = false -%}
          {%- if block.settings.link != blank -%}
            {%- assign has_link = true -%}
          {%- endif -%}
          {%- capture slide_label -%}
            {%- if block.settings.alt_text != blank -%}
              {{- block.settings.alt_text -}}
            {%- else -%}
              Slide {{ forloop.index }}
            {%- endif -%}
          {%- endcapture -%}
          <div class="swiper-slide hero-slider__slide" {{ block.shopify_attributes }}>
            {%- if has_link -%}
              <a href="{{ block.settings.link }}" class="hero-slider__link" aria-label="{{ slide_label | strip | escape }}">
            {%- endif -%}

            {%- liquid
              assign has_desktop_video = false
              assign has_mobile_video = false
              if block.settings.video_desktop != blank
                assign has_desktop_video = true
              endif
              if block.settings.video_mobile != blank
                assign has_mobile_video = true
              endif

              assign desktop_video_class = 'hero-slider__video hero-slider__video--desktop'
              assign mobile_video_class = 'hero-slider__video hero-slider__video--mobile'
              unless has_mobile_video
                assign desktop_video_class = desktop_video_class | append: ' hero-slider__video--only'
              endunless
              unless has_desktop_video
                assign mobile_video_class = mobile_video_class | append: ' hero-slider__video--only'
              endunless
            -%}
            <div class="hero-slider__media">
              {%- if has_desktop_video or has_mobile_video -%}
                {%- if has_desktop_video -%}
                  {{
                    block.settings.video_desktop
                    | video_tag:
                      image_size: '1600x',
                      autoplay: false,
                      loop: true,
                      controls: false,
                      muted: true,
                      class: desktop_video_class
                  }}
                {%- endif -%}
                {%- if has_mobile_video -%}
                  {{
                    block.settings.video_mobile
                    | video_tag:
                      image_size: '1600x',
                      autoplay: false,
                      loop: true,
                      controls: false,
                      muted: true,
                      class: mobile_video_class
                  }}
                {%- endif -%}
              {%- elsif block.settings.image != blank or block.settings.image_mobile != blank -%}
                {%- liquid
                  assign widths = '375, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                  assign loading = 'lazy'
                  if forloop.first
                    assign loading = 'eager'
                  endif

                  assign has_desktop_image = false
                  assign has_mobile_image = false
                  if block.settings.image != blank
                    assign has_desktop_image = true
                  endif
                  if block.settings.image_mobile != blank
                    assign has_mobile_image = true
                  endif

                  assign desktop_image_class = 'hero-slider__image hero-slider__image--desktop'
                  assign mobile_image_class = 'hero-slider__image hero-slider__image--mobile'
                  unless has_mobile_image
                    assign desktop_image_class = desktop_image_class | append: ' hero-slider__image--only'
                  endunless
                  unless has_desktop_image
                    assign mobile_image_class = mobile_image_class | append: ' hero-slider__image--only'
                  endunless
                -%}
                {%- if has_desktop_image -%}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag:
                      loading: loading,
                      sizes: '100vw',
                      widths: widths,
                      alt: block.settings.alt_text,
                      class: desktop_image_class
                  }}
                {%- endif -%}
                {%- if has_mobile_image -%}
                  {{
                    block.settings.image_mobile
                    | image_url: width: 1500
                    | image_tag:
                      loading: loading,
                      sizes: '100vw',
                      widths: '375, 550, 750, 1100, 1500',
                      alt: block.settings.alt_text,
                      class: mobile_image_class
                  }}
                {%- endif -%}
              {%- else -%}
                {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
                {%- if placeholder_slide == 1 -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hero-slider__image' }}
                {%- else -%}
                  {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg hero-slider__image' }}
                {%- endif -%}
              {%- endif -%}
            </div>

            {%- if has_link -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 and section.settings.show_navigation -%}
        <button type="button" class="swiper-button-prev hero-slider__nav-button" aria-label="Previous slide">
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </button>
        <button type="button" class="swiper-button-next hero-slider__nav-button" aria-label="Next slide">
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </button>
      {%- endif -%}

      {%- if section.blocks.size > 1 and section.settings.show_pagination -%}
        <div class="swiper-pagination hero-slider__pagination"></div>
      {%- endif -%}
    </div>
  </hero-slider>
</div>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 10,
      "settings": [
        {
          "type": "paragraph",
          "content": "Add a video below to use it for this slide, otherwise the image is used. Set a mobile video to show a different video on small screens; if left blank, the desktop video (or image) is used on mobile too."
        },
        {
          "type": "video",
          "id": "video_desktop",
          "label": "Video (desktop)"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Video (mobile)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)",
          "info": "Used when no video is set"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (mobile)",
          "info": "Optional. Falls back to the desktop image if left blank."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text / accessibility label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Makes the whole slide clickable"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
