{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .gold-rates-card-section {
    display: flex;
    justify-content: center;
  }

  .gold-rates-card {
    width: 100%;
    margin: 0 auto;
    background: rgb(var(--color-background));
    border-radius: 1.6rem;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.12);
    padding: 2.4rem 2.8rem 2rem;
    text-align: center;
    max-width:40rem;
  }

  .gold-rates-card__title {
    margin: 0;
    color: #1a1a1a;
    font-family: "lovan";
    font-size: 2.4rem;
    font-weight: 700;
  }

  .gold-rates-card__divider {
    display: flex;
    align-items: center;
    margin: 1.2rem 0 1.6rem;
  }

  .gold-rates-card__divider::before,
  .gold-rates-card__divider::after {
    content: '';
    flex: 1;
    height: 0.125rem;
    background: linear-gradient(to right, #dfae26, #925924, #fbe284);
  }

  .gold-rates-card__divider::after {
    background: linear-gradient(to left, #dfae26, #925924, #fbe284);
  }

  .gold-rates-card__divider svg {
    flex-shrink: 0;
    margin: 0 1rem;
  }

  .gold-rates-card__list {
    margin: 0 0 1.4rem;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .gold-rates-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.9rem 0;
    border-bottom: 0.1rem solid rgba(0, 0, 0, 0.08);
    color: #1a1a1a;
    font-family: "Helvetica Neue";
    font-size: 1.6rem;
  }

  .gold-rates-card__row:last-child {
    border-bottom: none;
  }

  .gold-rates-card__price {
    font-weight: 600;
  }

  .gold-rates-card__unit {
    margin-left: 0.3rem;
    font-size: 1.2rem;
    font-weight: 400;
    opacity: 0.6;
  }

  .gold-rates-card__note,
  .gold-rates-card__updated {
    margin: 0;
    color: #8a8a8a;
    font-family: "Helvetica Neue";
    font-size: 1.2rem;
  }

  .gold-rates-card__note {
    margin-top: 0.4rem;
    font-weight: 600;
  }

  .gold-rates-card__updated {
    margin-top: 0.4rem;
  }
{%- endstyle -%}

{%- liquid
  assign metal_blocks = section.blocks | where: 'type', 'metal_rate'
-%}

<div class="gold-rates-card-section color-{{ section.settings.color_scheme }} gradient page-width section-{{ section.id }}-padding">
  <div class="gold-rates-card">
    {%- if section.settings.heading != blank -%}
      <p class="gold-rates-card__title">{{ section.settings.heading | escape }}</p>
    {%- endif -%}

    {%- if metal_blocks.size > 0 -%}
      <ul class="gold-rates-card__list" role="list">
        {%- for block in metal_blocks -%}
          <li class="gold-rates-card__row" {{ block.shopify_attributes }}>
            <span class="gold-rates-card__label">{{ block.settings.label }}</span>
            <span class="gold-rates-card__price">
              {{- block.settings.price -}}
              {%- if block.settings.unit != blank -%}
                <span class="gold-rates-card__unit">{{ block.settings.unit }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="gold-rates-card__note">{{ section.settings.note | escape }}</p>
    {%- endif -%}

    {%- if section.settings.show_updated -%}
      <p class="gold-rates-card__updated">
          {%- assign updated_at_ist = section.settings.updated_at | date: '%s' | plus: 19800 -%}
          Updated on {{ updated_at_ist | date: "%d %b %Y, %I:%M %p" }}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Gold rates card",
  "class": "gold-rates-card-section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Today's Gold Rates"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Applicable for online purchase only"
    },
    {
      "type": "checkbox",
      "id": "show_updated",
      "label": "Show \"updated on\" timestamp",
      "default": true
    },
    {
      "type": "text",
      "id": "updated_at",
      "label": "Updated on",
      "info": "e.g. Tuesday, July 15, 2026 at 06:08 PM. Leave blank to use today's date/time automatically."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "metal_rate",
      "name": "Metal rate",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "24K Gold"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹14355"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unit (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gold rates card",
      "blocks": [
        { "type": "metal_rate", "settings": { "label": "24K Gold", "price": "₹14355" } },
        { "type": "metal_rate", "settings": { "label": "22K Gold", "price": "₹13287" } },
        { "type": "metal_rate", "settings": { "label": "18K Gold", "price": "₹11236" } },
        { "type": "metal_rate", "settings": { "label": "14K Gold", "price": "₹8593" } },
        { "type": "metal_rate", "settings": { "label": "9K Gold", "price": "₹5560" } },
        { "type": "metal_rate", "settings": { "label": "Platinum", "price": "₹7090" } },
        { "type": "metal_rate", "settings": { "label": "Silver", "price": "₹228" } }
      ]
    }
  ]
}
{% endschema %}
