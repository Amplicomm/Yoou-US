<style>
/* -------- Tabs -------- */
.tab-buttons{
  display:flex;
  justify-content:center;
  gap:20px;
  margin:40px 0 30px;
}
.tab-btn{
  border-radius:10px;
  color:#E0652A;
  font-weight:600;
  border:2px solid white;
  cursor:pointer;
  transition:0.3s;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:8px;
}

.tab-btn img.tab-img{
  width:260px;
  height:120px;
  object-fit:cover;
  border-radius:10px;
  border:1px solid #ddd;
}
.tab-btn img.tab-img.active-img {
 border:3px solid #E0652A;
}
.tab-btn.active{
  background:white;
  border-color:white;
}
.tab-contents{
padding:20px;
justify-content:center
}
.tab-contents h2 {
  font-size: 3.8rem;
  font-family: "lovan";
}


/* -------- Content -------- */
.tab-content{display:none;animation:fadeIn .3s ease}
.tab-content.active{
display:flex;justify-content:center;width:100%;flex-direction:column;
}


@keyframes fadeIn {
  from { opacity:0; transform:translateY(10px); }
  to   { opacity:1; transform:translateY(0); }
}

h2,h3{
  {% comment %} color:#5a2e8a; {% endcomment %}
  margin-bottom:10px;
  font-weight:700;
      margin-top: 45px;
}
p{
  color:#444;
  margin-bottom:18px;
  line-height:1.7;
}

/* -------- Steps -------- */
.steps-wrapper {
  display: flex;
  gap: 30px;
  justify-content: center;
  flex-wrap: wrap;
  margin: 30px 0;
}

.step-card {
  width:35%;
  background: #f8f8f8;
  padding: 40px 10px;
  border-radius: 24px;
  text-align: center;
}

.step-image {
  width: 250px;
  height: 250px;
  margin: auto;
  border-radius: 50%;
  overflow: hidden;
}

.step-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.step-title {
  font-size: 22px;
  font-weight: 600;
  margin-top: 25px;
  font-family:"lovan";
}
.step-description {
  display: flex;
  flex-direction: column;
  margin-top:20px
}
.step-description ul {
  text-align: left;
  margin-top: 20px;
  line-height: 1.7;
  max-width: 80%;
  list-style: circle;
  align-self: center;
}

@media (max-width: 768px) {
  .step-card {  width:100%}
  .step-image { width: 200px; height: 200px; }
  .tab-buttons{
    gap:5px
  }
  .tab-btn img.tab-img{
    width:150px;
    height:100px
  }
}
@media (max-width: 420px) {
  .tab-buttons .tab-btn {
    padding: 10px 10px;
  }
  .tab-btn img.tab-img{
    width: 125px;
    height: 80px;
  }
}

{% comment %} Size Chart Table {% endcomment %}
 .size-guide-table-wrapper {
  display: flex;
  justify-content: center;
  gap:20px;
  flex-wrap: wrap;
  margin-top: 40px;
  margin-bottom:40px;
}

.table-box {
  width:35%;
  background: #f8f8f8;
  border-radius: 18px;
  text-align: center;
  border:1px solid #e7e7e7;
  overflow:hidden;

}

.table-heading {
  background: #e7e7e7;
  border-radius: 14px 14px 0 0;
  padding: 13px;
  font-size: 18px;
  font-weight: 600;
  {% comment %} color: #4d2270; {% endcomment %}
  margin:0
}

.table-content table {
  width: 100%;
  border-collapse: collapse;
}

.table-content td,
.table-content th {
  padding: 12px;
  border: 1px solid #ddd;
  font-size: 14px;
}

@media (max-width: 768px) {
  .size-guide-table-wrapper { gap: 20px; }
  .table-box { flex: 1 1 100%; }
}

{% comment %} Image With Text {% endcomment %}
.img-text {
  display: flex;
  align-items: center;
  gap: 40px;
  margin: 40px 0;
      justify-content: center;
}

.img-text .img-box img {
  width: 100%;
  border-radius: 6px;
}

.img-text .text-box ,.img-text .img-box{
  width: 35%;
}

.step-title {
  font-size: 32px;
  margin-bottom: 15px;
}

.img-step-description ul {
  margin-left: 20px;
  list-style: disc;
  line-height: 1.8;
  text-align:left;
  font-size:20px;
}

@media(max-width: 768px) {
  .img-text {
    flex-direction: column;
    text-align: center;
  }
  .step-description ul {
    text-align: left;
  }
  .img-text .text-box ,.img-text .img-box{
    width: 100%;
  }

}


/* -------- Responsive -------- */
@media(max-width:768px){
  .img-text{flex-direction:column;text-align:center}
  .tab-btn{font-size:14px;padding:10px 20px}
  .step-box{width:100%;}
}
</style>

{% assign tabs = section.blocks | where: 'type', 'tab' %}

<div class="tab-buttons">
  {% for tab in tabs %}
    <button class="tab-btn{% if forloop.first %} active{% endif %}" data-tab="{{ tab.settings.tab_id }}">

      {% if tab.settings.image != blank %}
        <img src="{{ tab.settings.image | img_url: '260x' }}" alt="{{ tab.settings.tab_title }}" class="tab-img">
      {% endif %}

      {{ tab.settings.tab_title }}

    </button>
  {% endfor %}
</div>

<div class="tab-contents">
  {% for tab in tabs %}
    <div class="tab-content{% if forloop.first %} active{% endif %}" id="{{ tab.settings.tab_id }}">

      {% for block in section.blocks %}
        {% if block.settings.parent_tab == tab.settings.tab_id %}
          {% case block.type %}

          {% when 'section_heading' %}
            <div style="justify-content:center;max-width:70%;text-align:center;align-self:center">
              <h2>{{ block.settings.heading }}</h2>
              {% if block.settings.subheading != blank %}
                <p>{{ block.settings.subheading }}</p>
              {% endif %}
              {% if block.settings.para != blank %}
                <p>{{ block.settings.para }}</p>
              {% endif %}

            </div>

          {% when 'steps' %}
          <h2 style="text-align:center">{{ block.settings.step_title }}</h2>
          <div class="steps-wrapper">
            
            {% if block.settings.step_image1 or block.settings.step_description1 %}
            <div class="step-card">
              {% if block.settings.step_image1 %}
              <div class="step-image">
                <img src="{{ block.settings.step_image1 | img_url: '600x600' }}" alt="Step Image 1">
              </div>
              {% endif %}
              <div class="step-description">
                {{ block.settings.step_description1 | richtext }}
              </div>
            </div>
            {% endif %}

            {% if block.settings.step_image2 or block.settings.step_description2 %}
            <div class="step-card">
              {% if block.settings.step_image2 %}
              <div class="step-image">
                <img src="{{ block.settings.step_image2 | img_url: '600x600' }}" alt="Step Image 2">
              </div>
              {% endif %}
              <div class="step-description">
                {{ block.settings.step_description2 | richtext }}
              </div>
            </div>
            {% endif %}

          </div>

          {% when 'size_chart' %}
            {% if block.settings.table_html1 != blank or block.settings.table_html2 != blank %}
            <div class="size-guide-table-wrapper">

              {% if block.settings.table_html1 != blank %}
                <div class="table-box">
                  {% if block.settings.table_title1 != blank %}
                    <h3 class="table-heading">{{ block.settings.table_title1 }}</h3>
                  {% endif %}
                  <div class="table-content">
                    {{ block.settings.table_html1 }}
                  </div>
                </div>
              {% endif %}

              {% if block.settings.table_html2 != blank %}
                <div class="table-box">
                  {% if block.settings.table_title2 != blank %}
                    <h3 class="table-heading">{{ block.settings.table_title2 }}</h3>
                  {% endif %}
                  <div class="table-content">
                    {{ block.settings.table_html2 }}
                  </div>
                </div>
              {% endif %}

            </div>
          {% endif %}




          {% when 'image_text' %}
            {% if block.settings.step_title %}
              <h3 style="text-align:center" class="step-title">{{ block.settings.step_title }}</h3>
            {% endif %}

            <div class="img-text">
              {% if block.settings.step_image %}
                <div class="img-box">
                  <img src="{{ block.settings.step_image | img_url: '800x' }}" alt="{{ block.settings.step_title }}">
                </div>
              {% endif %}

              <div class="text-box">
         
                {% if block.settings.step_description %}
                  <div class="img-step-description">
                    {{ block.settings.step_description }}
                  </div>
                {% endif %}
              </div>
            </div>

          {% endcase %}
        {% endif %}
      {% endfor %}
    </div>
  {% endfor %}
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const tabs = document.querySelectorAll(".tab-btn");
  const contents = document.querySelectorAll(".tab-content");

  tabs.forEach(btn => {
    btn.addEventListener("click", () => {

      tabs.forEach(b => {
        b.classList.remove("active");
        const img = b.querySelector(".tab-img");
        if (img) img.classList.remove("active-img");
      });

      contents.forEach(c => c.classList.remove("active"));

      btn.classList.add("active");
      const activeImg = btn.querySelector(".tab-img");
      if (activeImg) activeImg.classList.add("active-img");

      document.getElementById(btn.dataset.tab).classList.add("active");
    });
  });

  // ⭐ Default: set active-img for the first tab on page load
  const firstTabImg = tabs[0].querySelector(".tab-img");
  if (firstTabImg) firstTabImg.classList.add("active-img");
});

</script>


{% schema %}
{
  "name": "Size Guide Tabs",
  "settings": [
    { "type": "text", "id": "custom_class", "label": "Custom CSS Class" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "tab_id", "label": "Tab Unique ID (example: ring)" },
        { "type": "text", "id": "tab_title", "label": "Tab Title" },
        { "type":"image_picker","id":"image","label":"Image"}

      ]
    },
    {
      "type": "section_heading",
      "name": "Section Heading",
      "settings": [
        { "type": "text", "id": "parent_tab", "label": "Attach To Tab ID" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "subheading", "label": "Sub Heading" },
        { "type": "text", "id": "para", "label": "Para" }
      ]
    },
    {
      "type": "steps",
      "name": "Steps Section",
      "settings": [
        { "type": "text", "id": "parent_tab", "label": "Attach To Tab ID" },
        {
          "type": "text",
          "id": "step_title",
          "label": "Step Title",
          "default": "Step 1"
        },
        {
          "type": "image_picker",
          "id": "step_image1",
          "label": "Step Image 1"
        },
        {
          "type": "richtext",
          "id": "step_description1",
          "label": "Step Description 1",
          "default": "<ul><li>Add bullet text like this</li><li>Describe steps here</li></ul>"
        },
         {
          "type": "image_picker",
          "id": "step_image2",
          "label": "Step Image 2"
        },
        {
          "type": "richtext",
          "id": "step_description2",
          "label": "Step Description 2",
          "default": "<ul><li>Add bullet text like this</li><li>Describe steps here</li></ul>"
        }
      ]
    },
    {
      "type": "size_chart",
      "name": "Size Chart Table",
      "settings": [
        { "type": "text", "id": "parent_tab", "label": "Attach To Tab ID" },
        { "type": "text", "id": "table_title1", "label": "Table Title 1", "default": "Ring Size (Indian)" },
        { "type": "html", "id": "table_html1", "label": "Table HTML 1" },
        { "type": "text", "id": "table_title2", "label": "Table Title 2", "default": "Ring Size (Indian)" },
        { "type": "html", "id": "table_html2", "label": "Table HTML 2" }
      ]
    },
    {
      "type": "image_text",
      "name": "Image With Text",
      "settings": [
        { "type": "text", "id": "parent_tab", "label": "Attach To Tab ID" },
        { "type": "text", "id": "step_title", "label": "Step Title", "default": "Step 1" },
        { "type": "image_picker", "id": "step_image", "label": "Step Image" },
        { "type": "richtext", "id": "step_description", "label": "Step Description", "default": "<ul><li>Add bullet text like this</li><li>Describe steps here</li></ul>" }
      ]
    }
  ],
  "presets": [
    { "name": "Size Guide Tabs" }
  ]
}
{% endschema %}
