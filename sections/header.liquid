{%- endif -%}

{%- liquid
  assign home_page = false
  if request.page_type == 'index'
    assign home_page = true
  endif
-%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 2.4rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 2.4rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    /* Safe to animate now: the "Filter and sort" bar (component-facets.css)
       no longer relies on a separately-toggled CSS transition landing in
       sync with this one — it's position: fixed, tracked continuously via a
       live getBoundingClientRect() reading of this header's actual current
       position (see metal-price-bar.liquid), so it follows along smoothly
       with whatever this is doing, mid-transition or not. */
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    /* Pre-promotes this to its own GPU compositor layer instead of paying
       that cost the first time the transform actually changes — without
       this, only the first couple of hide/show triggers are janky (that's
       when the layer gets created) and it becomes smooth afterward, since
       by then the layer already exists. */
    will-change: transform;
  }

  {%- if section.settings.sticky_header_type == 'always' -%}
    {%- if home_page -%}
      /* Home page: header is fixed and starts transparent so it overlays the
         hero/first section, turning into the gradient once scrolled past. */
      .section-header {
        position: fixed;
        top: var(--metal-price-bar-height, 0px);
        left: 0;
        width: 100%;
        margin-bottom: 0;
        z-index: 4;
      }

      .header-wrapper {
        background-color: rgba(25, 8, 0, 0) !important;
      }

      .section-header.scrolled-past-header .header-wrapper {
        background: linear-gradient(180deg, #E0652A 0%, #7A3717 100%) !important;
        border-radius:0 0 3rem 3rem
      }
    {%- else -%}
      /* Other pages: header stays in normal flow (position: sticky, not
         fixed) so it never overlays the page's first fold, and it always
         shows the gradient background (never transparent, not tied to
         scroll). */
      .section-header {
        position: sticky;
        top: var(--metal-price-bar-height, 0px);
        z-index: 4;
      }

      .section-header .header-wrapper {
        background: linear-gradient(180deg, #E0652A 0%, #7A3717 100%) !important;
        border-radius:0 0 3rem 3rem
      }
    {%- endif -%}

    /* The metal price bar (see metal-price-bar.liquid) hides itself on
       scroll down and marks <html> with this class. Both the home (fixed)
       and other-pages (sticky) branches above pin .section-header at
       var(--metal-price-bar-height) to sit right below the bar — once the
       bar is gone, shift up by that same amount to reclaim the space
       instead of leaving a gap. Uses transform rather than changing top:
       the price bar itself hides via transform (see metal-price-bar.liquid),
       and top-based movement requires the browser to re-run layout every
       animation frame while transform is compositor-only — mixing the two
       let the header visibly lag a frame or more behind the price bar
       instead of moving in the exact same lockstep. */
    html.metal-price-bar-hidden .section-header {
      transform: translateY(calc(-1 * var(--metal-price-bar-height, 0px)));
    }

    {% if template == 'collection' %}
      .section-header .header-wrapper {
          background: linear-gradient(180deg, #E0652A 0%, #7A3717 100%) !important;
          border-radius: 0 0 3rem 3rem;
          position: absolute;
          width: 100%;
      }
    {% endif %}

    /* Once the sticky header scrolls down far enough to sit on top of the
       footer, switch it to a plain white background instead of its usual
       background — the footer sitting right behind it doesn't read well
       through/against that background. --color-foreground is overridden
       too, since the header's text/icons are white by default on the home
       page's transparent/orange states and would otherwise vanish on white.
       Works the same way on every page. */
    .section-header.header--over-footer .header-wrapper {
      --color-foreground: 122, 55, 23;
      background: #fff !important;
    }
    .section-header.header--over-footer .swym-header-icon-html path {
        stroke: #7A3717;
    }
    .section-header.header--over-footer .header-wrapper svg {
      stroke: rgb(var(--color-foreground));
    }
    .section-header.header--over-footer .header__search-trigger-icon-wrap svg path {
      stroke:none;
      fill:rgb(var(--color-foreground));
    }
    .section-header.header--over-footer .header-wrapper .header__icon--menu svg path {
      fill:rgb(var(--color-foreground));
      stroke:none;
    }

    {%- if home_page -%}
      /* Swaps in dedicated logos for the transparent and over-footer states,
         when the merchant has set them via "Logo for transparent header" /
         "Logo over footer" — otherwise only the .header__heading-logo--solid
         variant is rendered at all and there's nothing to toggle. */
      .header__heading-logo--solid,
      .header__heading-logo--footer {
        display: none;
      }

      .section-header.scrolled-past-header .header__heading-logo--transparent,
      .section-header.header--over-footer .header__heading-logo--transparent {
        display: none;
      }

      .section-header.scrolled-past-header .header__heading-logo--solid {
        display: block;
      }

      .section-header.header--over-footer .header__heading-logo--solid {
        display: none;
      }

      .section-header.header--over-footer .header__heading-logo--footer {
        display: block;
      }
    {%- else -%}
      /* Other pages never render the transparent logo variant (nothing is
         ever transparent there) — just swap the normal logo for the footer
         logo once the header sits over the footer, same as on the home page. */
      .header__heading-logo--footer {
        display: none;
      }

      .section-header.header--over-footer .header__heading-logo--solid {
        display: none;
      }

      .section-header.header--over-footer .header__heading-logo--footer {
        display: block;
      }
    {%- endif -%}
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}">
    {%- liquid
      if section.settings.menu != blank
        render 'header-drawer'
      endif

      if section.settings.logo_position == 'top-center' or section.settings.menu == blank
        render 'header-search', input_id: 'Search-In-Modal-1'
      endif
    -%}

    {%- if section.settings.logo_position != 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
            {%- if home_page and section.settings.sticky_header_type == 'always' and section.settings.transparent_logo != blank
              or home_page and section.settings.sticky_header_type == 'always' and section.settings.footer_logo != blank
            -%}
              {%- assign transparent_logo_image = section.settings.transparent_logo | default: settings.logo -%}
              {%- assign footer_logo_image = section.settings.footer_logo | default: settings.logo -%}
              {%- render 'header-logo',
                logo: transparent_logo_image,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--transparent',
                preload: true
              -%}
              {%- render 'header-logo',
                logo: settings.logo,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--solid',
                preload: false
              -%}
              {%- render 'header-logo',
                logo: footer_logo_image,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--footer',
                preload: false
              -%}
            {%- elsif section.settings.sticky_header_type == 'always' and section.settings.footer_logo != blank -%}
              {%- render 'header-logo',
                logo: settings.logo,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--solid',
                preload: true
              -%}
              {%- render 'header-logo',
                logo: section.settings.footer_logo,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--footer',
                preload: false
              -%}
            {%- else -%}
              {%- render 'header-logo', logo: settings.logo, logo_width: settings.logo_width, sizes: sizes, preload: true -%}
            {%- endif -%}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      if section.settings.menu != blank
        if section.settings.menu_type_desktop == 'dropdown'
          render 'header-dropdown-menu'
        elsif section.settings.menu_type_desktop != 'drawer'
          render 'header-mega-menu'
        endif
      endif
    %}

    {%- if section.settings.logo_position == 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {% capture sizes %}(min-width: 750px) {{ settings.logo_width }}px, 50vw{% endcapture %}
            {%- if home_page and section.settings.sticky_header_type == 'always' and section.settings.transparent_logo != blank
              or home_page and section.settings.sticky_header_type == 'always' and section.settings.footer_logo != blank
            -%}
              {%- assign transparent_logo_image = section.settings.transparent_logo | default: settings.logo -%}
              {%- assign footer_logo_image = section.settings.footer_logo | default: settings.logo -%}
              {%- render 'header-logo',
                logo: transparent_logo_image,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--transparent',
                preload: true
              -%}
              {%- render 'header-logo',
                logo: settings.logo,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--solid',
                preload: false
              -%}
              {%- render 'header-logo',
                logo: footer_logo_image,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--footer',
                preload: false
              -%}
            {%- elsif section.settings.sticky_header_type == 'always' and section.settings.footer_logo != blank -%}
              {%- render 'header-logo',
                logo: settings.logo,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--solid',
                preload: true
              -%}
              {%- render 'header-logo',
                logo: section.settings.footer_logo,
                logo_width: settings.logo_width,
                sizes: sizes,
                extra_class: 'header__heading-logo--footer',
                preload: false
              -%}
            {%- else -%}
              {%- render 'header-logo', logo: settings.logo, logo_width: settings.logo_width, sizes: sizes, preload: true -%}
            {%- endif -%}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
      <div class="desktop-localization-wrapper">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      {% render 'header-search', input_id: 'Search-In-Modal' %}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        <span class="svg-wrapper">{% render 'icons' icon: 'cart' %}</span>
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow"
        >
          {%- if section.settings.enable_customer_avatar -%}
            <account-icon>
              {%- if customer and customer.has_avatar? -%}
                {{ customer | avatar }}
              {%- else -%}
                <span class="svg-wrapper">{% render 'icons' icon:"account" %}</span>
              {%- endif -%}
            </account-icon>
          {%- else -%}
              <span class="svg-wrapper">{% render 'icons' icon:"account" %}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}
    </div>
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: section.settings.menu_type_desktop
  -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
      this.updateFooterOverlap();
    }

    setHeaderHeight() {
      // On the collection template, .header-wrapper (the actual visible
      // header box) is made position: absolute inside .section-header so it
      // can float transparently over the hero banner (see the CSS above) —
      // that collapses .section-header's own rendered height to 0, since an
      // absolutely-positioned child doesn't contribute to its parent's
      // height. Measuring the wrapper itself instead gives the real visible
      // height on every template, collapsed or not.
      const headerContent = this.header.querySelector('.header-wrapper') || this.header;
      document.documentElement.style.setProperty('--header-height', `${headerContent.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
      this.updateFooterOverlap();
    }

    updateFooterOverlap() {
      if (this.footer === undefined) {
        this.footer = document.querySelector('.footer');
      }
      if (!this.footer) return;

      // The header is fixed at the very top of the viewport, so it always
      // covers the band from 0 to its own height — once the footer's top
      // edge scrolls up into that same band, the footer is now sitting
      // underneath the header.
      const footerTop = this.footer.getBoundingClientRect().top;
      this.header.classList.toggle('header--over-footer', footerTop <= this.header.offsetHeight);
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

