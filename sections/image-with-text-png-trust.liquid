{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
.pngtrust-wrapper {
  max-width: 1400px;
  margin: auto;
  display: flex;
  align-items: center;
  gap: 40px;
  padding: 60px 20px;
  position: relative;
}

.pngtrust-wrapper.text_first { 
  flex-direction: row-reverse;
}

.pngtrust-image {
  flex: 1;
}

.trust-img {
  width: 100%;
  height: auto;
  border-radius: 22px;
  object-fit: cover;
}

.pngtrust-content {
  flex: 1;
  background: #E0652A; /* Purple */
  color: white;
  padding: 50px;
  border-radius: 28px;
  position: relative;
  box-shadow: 0 10px 35px rgba(0,0,0,0.15);
  z-index: 3;
}

.overlap-enabled .pngtrust-content {
  margin-left: -120px;
}

/* Default overlap when image is left */
.overlap-enabled.pngtrust-wrapper {
  position: relative;
}

.overlap-enabled .pngtrust-content {
  margin-left: -120px;
}

/* When layout is reversed (image on right) */
.overlap-enabled.text_first .pngtrust-content {
  margin-left: 0;
  margin-right: -120px;
}

/* Fix spacing on mobile */
@media (max-width: 768px) {
  .overlap-enabled .pngtrust-content,
  .overlap-enabled.text_first .pngtrust-content {
    margin-left: 0;
    margin-right: 0;
    margin-top: -80px;
  }
}

.pngtrust-title {
  font-size: 38px;
  font-weight: 700;
  margin-bottom: 20px;
  color: #fff; 
}

.pngtrust-text {
  font-size: 18px;
  line-height: 1.6;
  margin-bottom: 25px;
  color: #fff;

}

.pngtrust-btn {
  background: #f4d38c;
  padding: 14px 28px;
  border-radius: 12px;
  color: #432054;
  font-weight: 700;
}
.pngtrust-text a {
  color: rgb(255 255 255 / 85%) !important;  /* gray color */
  text-decoration: underline; /* optional */
}

.pngtrust-text a:hover {
  color: #6b6b6b !important; /* darker on hover */
}
/* Responsive */
@media (max-width: 768px) {
  .pngtrust-wrapper,
  .pngtrust-wrapper.text_first {
    flex-direction: column;
  }

.pngtrust-image{
    width:100%
}

  .pngtrust-content {
    padding: 35px 25px;
    width:90%
  }

  .pngtrust-title {
    font-size: 26px;
  }
  .pngtrust-text{
    font-size:12px
  }
}
{%- endstyle -%}



{%- liquid
  assign section_classes = section.settings.class_name
  assign overlay_class = ''
  if section.settings.content_layout == 'overlap'
    assign overlay_class = 'overlap-enabled'
  endif
-%}
<script>
document.addEventListener("DOMContentLoaded", function () {
  const hash = window.location.hash.replace("#", ""); // gold-exchange

  if (hash) {
    const target = document.querySelector(`.pngtrust.${hash}`);
    if (target) {
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  }
});


</script>

<section id="ImageTextTrust-{{ section.id }}" class="pngtrust {{ section_classes }}">
  <div class="pngtrust-wrapper {{ section.settings.layout }} {{ overlay_class }}">

    <div class="pngtrust-image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'trust-img' }}
      {% endif %}
    </div>

    <div class="pngtrust-content">
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'heading' %}
            <h2 class="pngtrust-title {{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>

          {% when 'caption' %}
            <div class="pngtrust-caption">{{ block.settings.caption }}</div>

          {% when 'text' %}
            <div class="pngtrust-text">{{ block.settings.text }}</div>

          {% when 'button' %}
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link }}" class="pngtrust-btn {{ block.settings.button_style }}">
                {{ block.settings.button_label }}
              </a>
            {% endif %}

        {% endcase %}
      {% endfor %}
    </div>

  </div>
</section>


