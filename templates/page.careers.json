    "custom_liquid_gEYYYz": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  Trust Badges - Custom Liquid Block\n  Add this code directly in Custom Liquid block in Shopify theme customizer\n{% endcomment %}\n\n<style>\n  .custom-trust-badges {\n    padding: 20px 0;\n    width: 100%;\n  }\n\n  /* Heading Style */\n  .custom-trust-badges-heading {\n    text-align: center;\n    font-size: 34px;\n    font-weight: 600;\n    color: #7A3717;\n    margin-bottom: 30px;\n    font-family:\"lovan\";\n  }\n\n  .custom-trust-badges-grid {\n    display: flex;\n    gap: 20px;\n    overflow-x: auto;  /* Allow horizontal scrolling */\n    padding: 0 15px;\n    justify-content: center;\n    cursor: grab;\n  }\n\n  .custom-trust-badge-card {\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    border-radius: 16px;\n    min-height: 200px;\n    background: none; /* No background */\n    flex-shrink: 0;\n    user-select: none;  /* Prevent text selection while dragging */\n    flex-grow: 0;\n  }\n\n  .custom-trust-badge-icon-wrap {\n    width: 80px;  /* Larger size */\n    height: 80px;\n    background: #fff;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 16px;\n    flex-shrink: 0;\n  }\n\n  .custom-trust-badge-icon {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n  }\n\n  .custom-trust-badge-title {\nfont-family:\"Helvetica Neue\";\n    font-size: 15px;\n    font-weight: 600;\n    color: #7A3717;\n    line-height: 1.3;\n    margin: 0;\n    word-break: break-word;\n  }\n\n    .custom-trust-badges-grid {\n      gap: 10px;\n    }\n.custom-trust-badge-card{\n  position: relative;\n}\n\n.custom-trust-badge-card::after {\ncontent: \"\";\n    position: absolute;\n    left: 0;\n    top: 50%;\n    width: 1px;\n    height: 50%;\n    transform:    translateY(-50%);\n    background: #d9d9d9;\n}\n  .custom-trust-badge-card:first-child::after {\n    display: none;\n  }\n\n  /* Large Screens (≥991px) */\n  @media (min-width: 991px) {\n    .custom-trust-badges-grid {\n      gap: 20px;\n    }\n\n    .custom-trust-badge-card {\n      min-height: 200px;\n      flex-basis: calc(20% - 20px); /* 5 cards in a row */\n    }\n  }\n\n  /* Medium Screens (768px - 990px) */\n  @media (max-width: 990px) and (min-width: 768px) {\n    .custom-trust-badges-grid {\n      gap: 20px;\n    }\n\n    .custom-trust-badge-card {\n      min-height: 150px;\n      flex-basis: calc(33.33% - 20px); /* 3 cards in a row */\n    }\n  }\n\n  /* Small Screens (≤767px) */\n  @media (max-width: 767px) {\n\n     .custom-trust-badges-heading{\n     font-size:26px;\n}\n\n    .custom-trust-badge-card {\n      padding: 20px 15px;\n      min-height: 110px;\n      gap: 10px;\n      flex-basis: calc(50% - 20px); /* 2 cards in a row */\n    }\n\n    .custom-trust-badge-title {\n      font-size: 13px;\n    }\n  }\n\n  /* Extra Small Mobile (≤480px) */\n  @media (max-width: 480px) {\n    .custom-trust-badges-grid {\n      gap: 8px;\ndisplay: grid;\n        grid-template-columns: 1fr 1fr;\n        justify-content: center;\n        align-items: center;\n    }\n.custom-trust-badges-grid .custom-trust-badge-card:last-child {\n  grid-column: 1 / -1;\n  justify-self: center;\n}  \n.custom-trust-badge-card:nth-child(odd)::after {\n    display: none;\n  }\n\n\n    .custom-trust-badge-card {\n      padding: 18px 12px;\n      min-height: 105px;\n    }\n\n    .custom-trust-badge-title {\n      font-size: 12px;\n    }\n  }\n</style>\n\n<div class=\"custom-trust-badges\">\n  <!-- Heading -->\n  <h2 class=\"custom-trust-badges-heading\">Our Core Values</h2>\n  \n  <!-- Trust Badges Grid -->\n  <div class=\"custom-trust-badges-grid\">\n    \n    <!-- Badge 1: A - Act with integrity -->\n    <div class=\"custom-trust-badge-card\">\n      <div class=\"custom-trust-badge-icon-wrap\">\n        <img \n          src=\"https://cdn.shopify.com/s/files/1/0948/3560/5790/files/networking-icon-related-marketing-line-260nw-2381032727.webp?v=1760607673\" \n          alt=\"A - Act with integrity\"\n          class=\"custom-trust-badge-icon\"\n          loading=\"lazy\"\n        >\n      </div>\n      <h3 class=\"custom-trust-badge-title\">A - Act with integrity</h3>\n    </div>\n    \n    <!-- Badge 2: B - Be collaborative -->\n    <div class=\"custom-trust-badge-card\">\n      <div class=\"custom-trust-badge-icon-wrap\">\n        <img \n          src=\"https://cdn.shopify.com/s/files/1/0948/3560/5790/files/809522.png?v=1760607664\" \n          alt=\"B - Be collaborative\"\n          class=\"custom-trust-badge-icon\"\n          loading=\"lazy\"\n        >\n      </div>\n      <h3 class=\"custom-trust-badge-title\">B - Be collaborative</h3>\n    </div>\n    \n    <!-- Badge 3: C - Customer Centric -->\n    <div class=\"custom-trust-badge-card\">\n      <div class=\"custom-trust-badge-icon-wrap\">\n        <img \n          src=\"https://cdn.shopify.com/s/files/1/0948/3560/5790/files/1326789-512.png?v=1760607664\" \n          alt=\"C - Customer Centric\"\n          class=\"custom-trust-badge-icon\"\n          loading=\"lazy\"\n        >\n      </div>\n      <h3 class=\"custom-trust-badge-title\">C - Customer Centric</h3>\n    </div>\n\n    <!-- Badge 4: D - Drive Excellence -->\n    <div class=\"custom-trust-badge-card\">\n      <div class=\"custom-trust-badge-icon-wrap\">\n        <img \n          src=\"https://cdn.shopify.com/s/files/1/0948/3560/5790/files/4532005-200.png?v=1760607664\" \n          alt=\"D - Drive Excellence\"\n          class=\"custom-trust-badge-icon\"\n          loading=\"lazy\"\n        >\n      </div>\n      <h3 class=\"custom-trust-badge-title\">D - Drive Excellence</h3>\n    </div>\n    \n    <!-- Badge 5: E - Engage with society -->\n    <div class=\"custom-trust-badge-card\">\n      <div class=\"custom-trust-badge-icon-wrap\">\n        <img \n          src=\"https://cdn.shopify.com/s/files/1/0948/3560/5790/files/ab62df9c9f16b9d10d1b517dc1f3336c.jpg?v=1760607664\" \n          alt=\"E - Engage with society\"\n          class=\"custom-trust-badge-icon\"\n          loading=\"lazy\"\n        >\n      </div>\n      <h3 class=\"custom-trust-badge-title\">E - Engage with society</h3>\n    </div>\n\n  </div>\n</div>",
