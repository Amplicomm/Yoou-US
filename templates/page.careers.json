       <td>Post Graduation</td>\n          <td>7 to 8 years of experience in L&amp;D</td>\n          <td>1692</td>\n        </tr>\n        <tr>\n          <td>Manager – Taxation</td>\n          <td>CA compulsory</td>\n          <td>5 to 6 years of experience in taxation</td>\n          <td>1825</td>\n        </tr>\n        <tr>\n          <td>Manager – Estate Management</td>\n          <td>Graduate</td>\n          <td>5 to 6 years of experience of property handling</td>\n          <td>1870</td>\n        </tr>\n        <tr>\n          <td>Officer – L&amp;D</td>\n          <td>Post Graduation</td>\n          <td>4 to 5 years of experience of Product and Process training</td>\n          <td>1863</td>\n        </tr>\n        <tr>\n          <td>Associate – Graphic Designer</td>\n          <td>BFA</td>\n          <td>3 to 4 years’ experience as Graphic Designer</td>\n          <td>1864</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n</body>\n</html>",
