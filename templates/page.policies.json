        "text_XiecWt": {
          "type": "text",
          "settings": {
            "text": "<p>Schemes Terms and Conditions</p><p>Kindly refer to the PDF file below for the terms and conditions of our schemes:</p><p><a href=\"https://pngadgil-my.sharepoint.com/:b:/p/avadhoot_joshi/IQCOf444hxo7RohGTWyYpt1NAb-ICCjiLgI_GQg6o9DSZXw?e=K3H7oO\" target=\"_blank\" title=\"PNG Jewellers Schemes\"><span style=\"text-decoration:underline\">Schemes</span></a><span style=\"text-decoration:underline\"><br/><br/></span>Payment Gateway Charges -<br/>No charges will apply to UPI payments.<br/>Payment gateway fee will be applicable on our app for all other payment methods.</p>"
          }
        }
      },
