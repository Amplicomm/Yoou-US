<script>
document.addEventListener('DOMContentLoaded', function () {

  const nav = document.querySelector('.bottom-nav');

  if (!nav) return;

  /* Combines two independent conditions into one visibility state: the nav
     stays hidden while the banner still covers the viewport (as before),
     and now also hides mid scroll-down even once past the banner, revealing
     again on scroll up — same behavior as the header/metal price bar. */
  let bannerCovering = false;
  let scrollingDown = false;

  function updateVisibility() {
    nav.classList.toggle('is-visible', !bannerCovering);
  }

  /* Show after banner */
  const banner = document.querySelector('.custom-banner-section');

  if (banner && typeof IntersectionObserver !== 'undefined') {
    bannerCovering = true;

    const observer = new IntersectionObserver(function(entries) {

      entries.forEach(function(entry) {
        bannerCovering = entry.intersectionRatio >= 0.9;
        updateVisibility();
      });

    }, {
      threshold: [0, 0.9, 1]
    });

    observer.observe(banner);
  }

  /* Hide on scroll down, reveal on scroll up */
  let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
  let ticking = false;

  function onScroll() {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

    if (scrollTop > lastScrollTop && scrollTop > nav.offsetHeight) {
      scrollingDown = true;
    } else if (scrollTop < lastScrollTop) {
      scrollingDown = false;
    }

    updateVisibility();
    lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
    ticking = false;
  }

  window.addEventListener('scroll', function () {
    if (!ticking) {
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });

  updateVisibility();

  /* Search click */
  const searchBtn = document.querySelector('[data-bottom-nav-search]');

  if (searchBtn) {

    searchBtn.addEventListener('click', function(e) {

      const headerSearch = document.querySelector('.header__icon--search');

      if (headerSearch) {
        e.preventDefault();
        headerSearch.click();
      }

    });

  }

});
</script>