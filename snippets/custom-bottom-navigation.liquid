<style>
.bottom-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    /* See the matching note on .section-header in header.liquid. */
    will-change: transform;
    border-top: 0.5px solid #E8702C;
    background: #fff;
}

.bottom-nav.is-visible{
  transform: translateY(0);
}

.bottom-nav__item{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:6px 4px;
  text-decoration:none;
  color:#817676;
  position:relative;
  transition:.25s ease;
}

.bottom-nav__icon{
  width:24px;
  height:24px;
  display:flex;
  align-items:center;
  justify-content:center;
}

.bottom-nav__icon svg{
  width:100%;
  height:100%;
  display:block;
}

.bottom-nav__label{
  font-size:10px;
  font-weight:400;
  line-height:16px;
  letter-spacing:.6px;
  color:inherit;
}

.bottom-nav__item.active{
  color:#F36958;
}

.bottom-nav__item.active .bottom-nav__label::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 3px;
    transform: translateX(-50%);
    width: 20px;
    height: 2px;
    background: #F36958;
    border-radius: 10px;
}

.bottom-nav__item:hover{
  color:#F36958;
}

.bottom-nav__item svg path{
  transition:.25s ease;
}

@media (min-width:990px){
  .bottom-nav{
    display:none;
  }
}

@media (max-width:989px){
  body{
    padding-bottom:72px;
  }
}

@media (max-width:480px){
  .bottom-nav{
    padding-top:10px;
    padding-bottom:calc(10px + env(safe-area-inset-bottom));
  }

  .bottom-nav__label{
    font-size:10px;
  }

  .bottom-nav__icon{
    width:22px;
    height:22px;
  }
}
</style>

